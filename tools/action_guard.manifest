# Action Card influence points - tools/action_guard.sh asserts each line below
# exists exactly once, verbatim. These are the places outside src/ui_action.* that
# change how the mode PLAYS; the mode's own two files are hash-guarded instead.
# format: <path><TAB><exact line><TAB># <why it matters>
src/ui_board.c	        if (round_reset || !action_card_is_mode_active()) {	# envelope reset gate: a Plex match must not inherit the previous match's meter
src/ui_board.c	    float env_dt = action_card_is_paused() ? 0.0f : frame_dt;	# freeze gate: the meter envelope stops while the badge event is paused
src/ui_board.c	            reverb_curve = 0.53222625f; /* 85% on the S-curve */	# peak clamp: caps the meter at 85 percent of the S-curve
src/ui_board.c	    float ac_card_lvl = action_card_begin_table(g, round_reset, reverb_synergy);	# meter input: the mode's right-hand meter is fed from the reverb envelope
src/ui_main.c	        if (!plexus_action_card_is_active()) settings.ruleset = RULESET_YAKUZA;	# ruleset lock: keeps the mode on KK-ADD-10 instead of the campaign Yakuza override
src/ui_main.c	    if (ac_mode) settings.ruleset = RULESET_KK_ADD_10;	# ruleset lock: the mode overwrites the shared settings with KK-ADD-10
src/ui_main.c	    engine_init(&g, ac_mode ? RULESET_KK_ADD_10 : settings.ruleset, init_rounds, match_seed);	# match start: Action Card matches always initialise on KK-ADD-10
src/ui_main.c	static float get_think_duration(int s)  { return (s == 0) ? 0.40f : (s == 1) ? 0.30f : 0.20f; }	# CPU pacing: think duration per anim_speed, shared with every mode
src/ui_main.c	    if (!plexus_speedcoin_is_active() && sec > event_beat_timer) event_beat_timer = sec;	# CPU step beat: 90-120 ms inter-step pause, excluded for Speedcoin only, NOT for Action Card
src/ui_plexus.c	static Difficulty s_ac_cfg_diff        = DIFFICULTY_EASY;	# difficulty source: the mode's own setting, defaulting to Easy
src/ui_plexus.c	        s->difficulty       = s_ac_cfg_diff;	# difficulty sync: the Plex config is pushed into the shared settings the mode reads
src/ui_input.c	    if (board_is_action_distraction_high()) return;	# hint suppression: Easy-mode hints are disabled at high distraction
